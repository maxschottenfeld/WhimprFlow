# Rust
/target
**/*.rs.bk

# Node / frontend
node_modules/
ui/dist/
ui/node_modules/

# Tauri build output
src-tauri/target/
src-tauri/gen/

# Models (downloaded separately — multi-GB, not committed)
*.gguf
*.bin

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Secrets — never commit. API keys live in the OS keychain, never in files.
.env
.env.*
*.pem

# Harness fixtures are generated (macOS `say` + afconvert) and are audio blobs;
# scripts/make-fixtures.sh regenerates them byte-identically on any Mac.
/fixtures/
# Overnight-run scratch files.
/OVERNIGHT-*.md
